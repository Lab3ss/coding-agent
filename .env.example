# Copy to .env.<scope> (e.g. .env.personal, .env.pro) — one file per scope.
# These files are gitignored. Never commit real tokens; never paste them in chat.

MATRIX_HOMESERVER=https://matrix.besson.tech/
MATRIX_TOKEN=        # access token of THIS scope's dedicated bot account
GH_TOKEN=            # fine-grained PAT scoped to ONLY this scope's repos
ANTHROPIC_API_KEY=   # this scope's Anthropic API key (per-scope billing); blank = use local CLI login
GIT_USER_NAME=Alexis Besson
GIT_USER_EMAIL=      # the email tied to this scope's GitHub account
WORKSPACE_ROOT=workspaces-personal   # unique per scope, never shared
SCOPE_LABEL=personal                 # label for logs
DAILY_USD_LIMIT=5.00                 # max spend per project per day; 0/blank = unlimited
MODEL=                               # e.g. claude-sonnet-4-6 (cheaper) or claude-haiku-4-5; blank = Opus default
