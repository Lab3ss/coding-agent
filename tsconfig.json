{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Node runs src/*.ts directly via type stripping, so only erasable
    // syntax is allowed (no enums/namespaces/param properties) — this flag
    // makes tsc enforce that exact subset.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
